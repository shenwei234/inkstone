# ===== InkStone 生产环境变量 =====
# 用法：复制为 .env 填好真实值，然后：
#   docker compose --env-file .env -f docker-compose.prod.yml up -d --build

# —— 数据库 / 后端（务必修改）——
DB_USER=blog
DB_PASSWORD=change_me_strong_password
DB_NAME=blog_platform
JWT_SECRET=change_me_64_char_random_string
APP_ENV=production

# —— 对外地址（改成你的域名）——
FRONTEND_URL=https://blog.shenv.top
# 封面/文件访问前缀。设为绝对域名，next/image 优化才能跨容器取到图；反代同源场景可留空
PUBLIC_API_URL=https://blog.shenv.top

# —— 前端（构建期注入，修改后必须重新 build 前端镜像）——
NEXT_PUBLIC_API_URL=https://blog.shenv.top/api/v1

# —— 监听绑定（默认仅本机，由 Nginx 对外）——
BACKEND_BIND=127.0.0.1
FRONTEND_BIND=127.0.0.1

# —— 可选：应急全局停用验证码 ——
# INKSTONE_DISABLE_CAPTCHA=1
